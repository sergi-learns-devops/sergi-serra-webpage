---
import "../styles/global.css";
import { siteConfig } from "../config";
import {
  getLangFromUrl,
  useTranslations,
  localizedPath,
  languages,
  type Lang,
} from "../i18n/ui";

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

/** Idiomas disponibles para el selector, con la ruta equivalente. */
const langOptions = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  label: languages[code],
  href: localizedPath(code),
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:locale" content={lang} />

    {/* Script anti-flash: aplica el tema antes del primer render. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)"
          ).matches;
          var theme = stored || (prefersDark ? "dark" : "light");
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skipToContent}</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-header__brand" href={localizedPath(lang)}>
          Sergi&nbsp;<span>Serra</span>
        </a>

        <nav class="site-nav" aria-label={t.nav.menu}>
          <ul class="site-nav__list">
            <li>
              <a class="site-nav__link" href="#about">{t.nav.about}</a>
            </li>
            <li>
              <a class="site-nav__link" href="#skills">{t.nav.skills}</a>
            </li>
            <li>
              <a class="site-nav__link" href="#certs">{t.nav.certs}</a>
            </li>
            <li>
              <a class="site-nav__link" href="#projects">{t.nav.projects}</a>
            </li>
            <li>
              <a class="site-nav__link" href="#vibe">{t.nav.vibe}</a>
            </li>
            <li>
              <a class="site-nav__link" href="#contact">{t.nav.contact}</a>
            </li>
          </ul>

          <div class="header__controls">
            <!-- Selector de idioma -->
            <div class="lang-switcher">
              <label class="sr-only" for="lang-select">{t.language.label}</label>
              <select
                id="lang-select"
                class="lang-switcher__select"
                aria-label={t.language.label}
              >
                {
                  langOptions.map((opt) => (
                    <option value={opt.href} selected={opt.code === lang}>
                      {opt.label}
                    </option>
                  ))
                }
              </select>
              <svg
                class="lang-switcher__icon"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>

            <!-- Toggle de tema -->
            <button
              type="button"
              id="theme-toggle"
              class="theme-toggle"
              aria-label={t.theme.toggle}
              title={t.theme.toggle}
            >
              <svg
                class="icon-sun"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="5"></circle>
                <line x1="12" y1="1" x2="12" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="23"></line>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                <line x1="1" y1="12" x2="3" y2="12"></line>
                <line x1="21" y1="12" x2="23" y2="12"></line>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
              </svg>
              <svg
                class="icon-moon"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
              </svg>
            </button>
          </div>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <p>
          &copy; {new Date().getFullYear()} Sergi Serra. {t.footer.rights}
          {" "}
          {t.footer.builtWith}
        </p>
        <div class="site-footer__social">
          <a
            href={siteConfig.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M4.98 3.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.3c0-1.26-.02-2.9-1.77-2.9-1.77 0-2.04 1.38-2.04 2.8V21H9z"
              ></path>
            </svg>
          </a>
          <a
            href={siteConfig.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.57.1.78-.25.78-.55v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.3-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.2-3.1-.12-.3-.52-1.48.1-3.08 0 0 .97-.31 3.2 1.18a11 11 0 0 1 5.82 0c2.23-1.5 3.2-1.18 3.2-1.18.63 1.6.23 2.78.11 3.08.75.81 1.2 1.84 1.2 3.1 0 4.43-2.7 5.4-5.26 5.69.42.36.78 1.06.78 2.14v3.17c0 .3.2.66.79.55A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </footer>

    {/* Lógica de tema e idioma (cliente). */}
    <script>
      // Toggle de tema con persistencia en localStorage.
      const toggle = document.getElementById("theme-toggle");
      toggle?.addEventListener("click", () => {
        const current =
          document.documentElement.getAttribute("data-theme") === "dark"
            ? "dark"
            : "light";
        const next = current === "dark" ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", next);
        try {
          localStorage.setItem("theme", next);
        } catch (e) {
          /* ignorar si localStorage no está disponible */
        }
      });

      // Selector de idioma: navega a la ruta equivalente.
      const langSelect = document.getElementById(
        "lang-select"
      ) as HTMLSelectElement | null;
      langSelect?.addEventListener("change", () => {
        const href = langSelect.value;
        if (href) window.location.href = href;
      });
    </script>
  </body>
</html>
