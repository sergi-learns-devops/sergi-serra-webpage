---
import type { UIStrings } from "../i18n/ui";
import { siteConfig } from "../config";

interface Props {
  t: UIStrings;
}

const { t } = Astro.props;
---

<section id="vibe" class="section" aria-labelledby="vibe-title">
  <div class="container">
    <h2 id="vibe-title" class="section__title">{t.vibe.title}</h2>
    <p class="section__intro">{t.vibe.intro}</p>

    <div class="vibe__layout">
      <!-- Workflow -->
      <div class="vibe__workflow">
        <h3 class="vibe__subtitle">{t.vibe.workflowTitle}</h3>
        <p class="vibe__hint">{t.vibe.workflowIntro}</p>
        <ol class="vibe__steps">
          {
            t.vibe.steps.map((step, i) => (
              <li class="vibe-step">
                <span class="vibe-step__num" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div class="vibe-step__body">
                  <h4 class="vibe-step__name">{step.name}</h4>
                  <p class="vibe-step__desc">{step.description}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <!-- Stack + prompt -->
      <aside class="vibe__side">
        <div class="vibe-card">
          <h3 class="vibe__subtitle">{t.vibe.stackTitle}</h3>
          <ul class="vibe-card__stack">
            {t.vibe.stack.map((item) => <li class="tag">{item}</li>)}
          </ul>
        </div>

        <figure class="vibe-prompt">
          <figcaption class="vibe-prompt__title">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="4 17 10 11 4 5"></polyline>
              <line x1="12" y1="19" x2="20" y2="19"></line>
            </svg>
            {t.vibe.promptTitle}
          </figcaption>
          <p class="vibe-prompt__hint">{t.vibe.promptIntro}</p>
          <blockquote class="vibe-prompt__text">{t.vibe.promptText}</blockquote>
          <a
            class="vibe-prompt__link"
            href={`${siteConfig.repo}#readme`}
            target="_blank"
            rel="noopener noreferrer"
          >
            {t.vibe.howTo}
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7 17L17 7"></path>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </a>
        </figure>
      </aside>
    </div>

    <!-- Otros proyectos vibe-codeados -->
    <div class="vibe__projects">
      <h3 class="vibe__subtitle">{t.vibe.projectsTitle}</h3>
      <p class="vibe__hint">{t.vibe.projectsIntro}</p>
      <ul class="vibe-projects__grid">
        {
          t.vibe.projects.map((project) => (
            <li>
              <a
                class="vibe-project-card"
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${project.name} (GitHub)`}
              >
                <div class="vibe-project-card__head">
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.57.1.78-.25.78-.55v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.3-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.2-3.1-.12-.3-.52-1.48.1-3.08 0 0 .97-.31 3.2 1.18a11 11 0 0 1 5.82 0c2.23-1.5 3.2-1.18 3.2-1.18.63 1.6.23 2.78.11 3.08.75.81 1.2 1.84 1.2 3.1 0 4.43-2.7 5.4-5.26 5.69.42.36.78 1.06.78 2.14v3.17c0 .3.2.66.79.55A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z" />
                  </svg>
                  <span class="vibe-project-card__name">{project.name}</span>
                  <svg
                    class="vibe-project-card__ext"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M7 17L17 7" />
                    <polyline points="7 7 17 7 17 17" />
                  </svg>
                </div>
                <p class="vibe-project-card__desc">{project.description}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
