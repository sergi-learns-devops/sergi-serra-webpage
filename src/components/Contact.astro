---
import type { UIStrings } from "../i18n/ui";
import { siteConfig } from "../config";

interface Props {
  t: UIStrings;
}

const { t } = Astro.props;
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container" data-reveal>
    <h2 id="contact-title" class="section__title">{t.contact.title}</h2>
    <p class="section__intro">{t.contact.intro}</p>
    <div class="contact__links">
      <a class="contact-card" href={`mailto:${siteConfig.email}`}>
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="2" y="4" width="20" height="16" rx="2"></rect>
          <path d="m22 7-10 6L2 7"></path>
        </svg>
        <span>{t.contact.emailLabel}</span>
      </a>

      <button
        type="button"
        class="contact-card contact-card--copy"
        id="copy-email"
        data-email={siteConfig.email}
        data-label-copy={t.contact.copyEmail}
        data-label-copied={t.contact.copied}
        aria-label={t.contact.copyEmail}
      >
        <svg
          class="icon-copy"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <svg
          class="icon-check"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          style="display:none"
        >
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span class="contact-card__copy-label">{t.contact.copyEmail}</span>
      </button>

      <a
        class="contact-card"
        href={siteConfig.linkedin}
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M4.98 3.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.3c0-1.26-.02-2.9-1.77-2.9-1.77 0-2.04 1.38-2.04 2.8V21H9z"
          ></path>
        </svg>
        <span>{t.contact.linkedinLabel}</span>
      </a>

      <a
        class="contact-card"
        href={siteConfig.github}
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.57.1.78-.25.78-.55v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.3-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.2-3.1-.12-.3-.52-1.48.1-3.08 0 0 .97-.31 3.2 1.18a11 11 0 0 1 5.82 0c2.23-1.5 3.2-1.18 3.2-1.18.63 1.6.23 2.78.11 3.08.75.81 1.2 1.84 1.2 3.1 0 4.43-2.7 5.4-5.26 5.69.42.36.78 1.06.78 2.14v3.17c0 .3.2.66.79.55A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z"
          ></path>
        </svg>
        <span>{t.contact.githubLabel}</span>
      </a>
    </div>
  </div>
</section>

<script>
  const btn = document.getElementById("copy-email");
  if (btn) {
    const email = btn.getAttribute("data-email") || "";
    const labelEl = btn.querySelector(".contact-card__copy-label");
    const iconCopy = btn.querySelector<HTMLElement>(".icon-copy");
    const iconCheck = btn.querySelector<HTMLElement>(".icon-check");
    const labelCopy = btn.getAttribute("data-label-copy") || "";
    const labelCopied = btn.getAttribute("data-label-copied") || "";
    let resetTimer: number | undefined;

    const showCopied = () => {
      if (labelEl) labelEl.textContent = labelCopied;
      if (iconCopy) iconCopy.style.display = "none";
      if (iconCheck) iconCheck.style.display = "";
      btn.classList.add("is-copied");
      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        if (labelEl) labelEl.textContent = labelCopy;
        if (iconCopy) iconCopy.style.display = "";
        if (iconCheck) iconCheck.style.display = "none";
        btn.classList.remove("is-copied");
      }, 2000);
    };

    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(email);
        showCopied();
      } catch (e) {
        // Fallback para navegadores sin Clipboard API.
        const ta = document.createElement("textarea");
        ta.value = email;
        ta.style.position = "fixed";
        ta.style.opacity = "0";
        document.body.appendChild(ta);
        ta.select();
        try {
          document.execCommand("copy");
          showCopied();
        } catch (err) {
          /* sin acción */
        }
        document.body.removeChild(ta);
      }
    });
  }
</script>
