---
import type { UIStrings } from "../i18n/ui";
import { siteConfig } from "../config";

interface Props {
  t: UIStrings;
}

const { t } = Astro.props;
---

<section id="certs" class="section section--alt" aria-labelledby="certs-title">
  <div class="container">
    <h2 id="certs-title" class="section__title">{t.certs.title}</h2>
    <p class="section__intro">{t.certs.intro}</p>

    <ul class="certs__badges">
      {
        t.certs.items.map((cert) => (
          <li class={`cert-badge${cert.status === "expired" ? " cert-badge--expired" : ""}`}>
            <div class="cert-badge__media">
              <img
                class="cert-badge__img"
                src={cert.image}
                alt={`${cert.name} — ${cert.issuer ?? t.certs.issuer}`}
                width="140"
                height="140"
                loading="lazy"
                decoding="async"
              />
              {cert.renewed && (
                <span class="cert-badge__mark cert-badge__mark--renewed">
                  {t.certs.renewedLabel} {cert.renewed}
                </span>
              )}
              {cert.status === "expired" && (
                <span class="cert-badge__mark cert-badge__mark--expired">
                  {t.certs.expiredLabel}
                </span>
              )}
            </div>
            <span class="cert-badge__name">{cert.name}</span>
          </li>
        ))
      }
    </ul>

    <div class="certs__cta">
      <a
        class="btn btn--primary"
        href={siteConfig.credly}
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M9 12l2 2 4-4"></path>
          <circle cx="12" cy="12" r="9"></circle>
        </svg>
        {t.certs.verifyAll}
      </a>
    </div>
  </div>
</section>
