---
import type { UIStrings } from "../i18n/ui";
import { siteConfig } from "../config";

interface Props {
  t: UIStrings;
}

const { t } = Astro.props;
---

<section id="certs" class="section section--alt" aria-labelledby="certs-title">
  <div class="container">
    <h2 id="certs-title" class="section__title">{t.certs.title}</h2>
    <p class="section__intro">{t.certs.intro}</p>

    <ul class="certs__grid">
      {
        t.certs.items.map((cert) => (
          <li class="cert-card">
            <div class="cert-card__badge" aria-hidden="true">
              {/* Icono Google Cloud */}
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M12 2 3 7v10l9 5 9-5V7l-9-5z"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                />
                <path
                  d="m8.5 12 2.3 2.3L15.8 9.3"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>
            <div class="cert-card__body">
              <h3 class="cert-card__name">{cert.name}</h3>
              <p class="cert-card__issuer">{t.certs.issuer}</p>
            </div>
            <span
              class={`cert-card__level ${
                cert.level === "Associate"
                  ? "cert-card__level--associate"
                  : "cert-card__level--professional"
              }`}
            >
              {cert.level === "Associate"
                ? t.certs.levelAssociate
                : t.certs.levelProfessional}
            </span>
          </li>
        ))
      }
    </ul>

    <div class="certs__cta">
      <a
        class="btn btn--primary"
        href={siteConfig.credly}
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M9 12l2 2 4-4"></path>
          <circle cx="12" cy="12" r="9"></circle>
        </svg>
        {t.certs.verifyAll}
      </a>
    </div>
  </div>
</section>
